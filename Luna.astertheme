{
  "format": "aster-theme",
  "version": 1,
  "theme": {
    "version": 1,
    "id": "luna",
    "title": "Luna",
    "profile": "windows",
    "shellMode": "dark",
    "appMode": "light",
    "accent": "#169fe6",
    "selection": "#169fe6",
    "autoAccent": false,
    "accentOnShell": false,
    "accentOnTitle": true,
    "transparency": true,
    "motion": true,
    "optics": {"quality":"high","bend":46,"dispersion":4,"magnify":true},
    "glass": "tinted",
    "iconStyle": "colorful",
    "iconFamily": "windows",
    "font": "system",
    "fontSize": 13,
    "titleHeight": 38,
    "borderWidth": 1,
    "radius": 12,
    "scrollbarWidth": 10,
    "taskbar": {"position":"bottom","align":"center","size":42,"autoHide":false,"showSearch":true,"showTaskView":true,"showWidgets":false},
    "background": {"type":"color","builtin":"midnight","color":"#07131d","fit":"fill","images":[],"interval":60000,"shuffle":false},
    "cursor": {"scheme":"default","size":24,"custom":{}},
    "sounds": {"enabled":false,"scheme":"aster","volume":35,"events":{}},
    "contrast": {"enabled":false,"colors":{"background":"#000000","text":"#ffffff","link":"#ffff00","disabled":"#9f9f9f","selection":"#00ffff","selectedText":"#000000","button":"#000000"}},
    "colors": {
      "Window":"#f3f6f9","WindowText":"#1a1a1a","ButtonFace":"#edf2f6","GrayText":"#667784",
      "ActiveTitle":"#0b4567","TitleText":"#ffffff","InactiveTitle":"#dfe7ec","InactiveTitleText":"#526674",
      "Hilight":"#169fe6","HilightText":"#ffffff"
    },
    "icons": {},
    "assets": {},
    "desktopBackgrounds": {}
  }
}
