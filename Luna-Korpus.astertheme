{
  "format": "aster-theme",
  "version": 1,
  "theme": {
    "version": 1,
    "id": "luna-korpus",
    "title": "Luna Korpus",
    "profile": "windows",
    "shellMode": "dark",
    "appMode": "light",
    "accent": "#0078c8",
    "selection": "#0078c8",
    "autoAccent": false,
    "accentOnShell": false,
    "accentOnTitle": true,
    "transparency": true,
    "motion": true,
    "optics": {
      "quality": "balanced",
      "bend": 65,
      "dispersion": 8,
      "magnify": true
    },
    "glass": "clear",
    "iconStyle": "colorful",
    "iconFamily": "windows",
    "font": "system",
    "fontSize": 13,
    "titleHeight": 36,
    "borderWidth": 1,
    "radius": 8,
    "scrollbarWidth": 10,
    "taskbar": {
      "position": "bottom",
      "align": "center",
      "size": 40,
      "autoHide": false,
      "showSearch": true,
      "showTaskView": true,
      "showWidgets": false
    },
    "assets": {
      "DesktopBackground/Luna-Shop-Grid.png": {
        "mime": "image/png",
        "data": ""
      }
    },
    "background": {
      "type": "picture",
      "builtin": "bloom",
      "color": "#0b3a5b",
      "fit": "fill",
      "images": [
        "DesktopBackground/Luna-Shop-Grid.png"
      ],
      "interval": 60000,
      "shuffle": false
    },
    "desktopBackgrounds": {},
    "cursor": {
      "scheme": "default",
      "size": 24,
      "custom": {}
    },
    "sounds": {
      "enabled": false,
      "scheme": "none",
      "volume": 35,
      "events": {}
    },
    "contrast": {
      "enabled": false,
      "colors": {
        "background": "#000000",
        "text": "#ffffff",
        "link": "#ffff00",
        "disabled": "#9f9f9f",
        "selection": "#00ffff",
        "selectedText": "#000000",
        "button": "#000000"
      }
    },
    "colors": {
      "Background": "#0b3a5b",
      "Window": "#f3f6f9",
      "WindowText": "#1a1a1a",
      "ButtonFace": "#f3f6f9",
      "ButtonText": "#1a1a1a",
      "Hilight": "#0078c8",
      "HilightText": "#ffffff",
      "ActiveTitle": "#0078c8",
      "TitleText": "#ffffff",
      "InactiveTitle": "#e5edf4",
      "InactiveTitleText": "#455768",
      "ActiveBorder": "#0078c8",
      "InactiveBorder": "#d5dce3",
      "GradientActiveTitle": "#0078c8",
      "GradientInactiveTitle": "#e5edf4",
      "MenuHilight": "#0078c8"
    },
    "icons": {}
  }
}
