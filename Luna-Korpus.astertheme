{
  "format": "aster-theme",
  "version": 1,
  "theme": {
    "version": 1,
    "id": "luna-korpus",
    "title": "Luna Korpus",
    "profile": "windows",
    "shellMode": "dark",
    "appMode": "light",
    "accent": "#0078c8",
    "selection": "#0078c8",
    "autoAccent": false,
    "accentOnShell": false,
    "accentOnTitle": true,
    "transparency": true,
    "motion": true,
    "optics": {
      "quality": "balanced",
      "bend": 65,
      "dispersion": 8,
      "magnify": true
    },
    "glass": "clear",
    "iconStyle": "colorful",
    "iconFamily": "windows",
    "font": "system",
    "fontSize": 13,
    "titleHeight": 36,
    "borderWidth": 1,
    "radius": 8,
    "scrollbarWidth": 10,
    "taskbar": {
      "position": "bottom",
      "align": "center",
      "size": 40,
      "autoHide": false,
      "showSearch": true,
      "showTaskView": true,
      "showWidgets": true
    },
    "assets": {},
    "background": {
      "type": "color",
      "builtin": "bloom",
      "color": "#0b3a5b",
      "fit": "fill",
      "images": [],
      "interval": 60000,
      "shuffle": false
    },
    "desktopBackgrounds": {},
    "cursor": {
      "scheme": "default",
      "size": 24,
      "custom": {}
    },
    "sounds": {
      "enabled": false,
      "scheme": "aster",
      "volume": 35,
      "events": {}
    },
    "contrast": {
      "enabled": false,
      "colors": {
        "background": "#000000",
        "text": "#ffffff",
        "link": "#ffff00",
        "disabled": "#9f9f9f",
        "selection": "#00ffff",
        "selectedText": "#000000",
        "button": "#000000"
      }
    },
    "colors": {
      "ActiveTitle": "#0078c8",
      "TitleText": "#ffffff"
    },
    "icons": {}
  }
}